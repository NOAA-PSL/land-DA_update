# environment and modules for compiling / running executables using GDASApp
# selected lines, taken from GDASApp/build.sh

# to do - make compiler an optional argument

# get GDAS directory
export dir_root="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"

export GDASApp_root=${dir_root}/GDASApp/
HOMEdir=${HOMEdir:-"$(dirname '${GDASApp_root}')"}   #/../"}

COMPILER="${COMPILER:-intel}"
source $GDASApp_root/ush/detect_machine.sh
source $GDASApp_root/ush/module-setup.sh

module purge
module use $GDASApp_root/modulefiles
module load GDAS/${MACHINE_ID}.$COMPILER
##module load mkl/2024.2.1
status=$?
if [[ ${status} -ne 0 ]]; then
    exit "error loading modules ${status}"
fi

PYVN=$(python -c 'import sys; print(".".join(sys.version.split(" ")[0].split(".")[0:2]))')

# set pythonpath for ioda converters
IODA_CONV=${GDASApp_root}/sorc/iodaconv/src/
IODAPY=${GDASApp_root}/build/lib/python${PYVN}/
WXFLOW=$HOMEdir/wxflow/src
JCB=${GDASApp_root}/sorc/jcb/src
#PYGFS=$HOMEdir

export PYTHONPATH=${IODA_CONV}:${IODAPY}:${IODAPY}/pyiodaconv:${WXFLOW}:${JCB}:${HOMEdir}:$PYTHONPATH
# turn off exit on error (set in detect_machine.sh)
set +e
